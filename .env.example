# SmartPOS Frontend Environment Variables Example
# Salin file ini menjadi `.env` jika diperlukan dan sesuaikan nilainya

# Backend Base URL (Local Development)
VITE_LOCAL_BACKEND_URL=http://127.0.0.1:4000

# Backend Base URL (Production Railway)
# Ganti dengan domain Railway backend Anda
VITE_PRODUCTION_BACKEND_URL=https://your-backend-service.up.railway.app
